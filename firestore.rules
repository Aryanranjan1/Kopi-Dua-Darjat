
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAdmin() {
      return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    // CMS Collections (Public Read + Admin Write)
    match /{collectionName}/{docId} where
      collectionName in ['menuGroups', 'menuCategories', 'menuItems', 'promotions', 'dailySpecials', 'outlets', 'blogs', 'media', 'settings', 'testimonials', 'faq'] {
      allow read: if true;
      allow write: if isAdmin();
    }

    // User-Submitted Collections
    match /contactMessages/{docId} {
      allow create: if true;
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    match /franchiseApplications/{docId} {
      allow create: if true;
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    match /newsletterSubscribers/{docId} {
      allow create: if true;
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    // Instagram Feed (Public Read + Restricted Write)
    match /public_insta_feed/{docId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin() || request.auth.token.firebase != null;
    }

    // Admin Roles
    match /roles_admin/{userId} {
      allow read, write: if isAdmin();
    }
  }
}
