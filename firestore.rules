
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Publicly readable data
    match /menuGroups/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /menuCategories/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /menuItems/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /promotions/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /outlets/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /dailySpecials/{docId} {
        allow read: if true;
        allow write: if isAdmin();
    }

    // Write-only collections for public submissions
    match /contactMessages/{docId} {
      allow read, delete: if isAdmin();
      allow create: if true;
      allow update: if false; // Users cannot update submissions
    }

    match /franchiseApplications/{docId} {
      allow read, delete: if isAdmin();
      allow create: if true;
      allow update: if false;
    }

    match /newsletterSubscribers/{docId} {
      // Admins can read/delete, anyone can create
      allow read, delete: if isAdmin();
      allow create: if true;
      allow update: if false;
    }
  }
}
