rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAdmin() {
      // In a real app, you would check for a custom claim.
      // For this MVP, we just check if the user is authenticated.
      return request.auth != null;
    }

    match /contactMessages/{docId} {
      allow read, delete: if isAdmin();
      allow create: if true; // Anyone can send a message
    }

    match /franchiseApplications/{docId} {
      allow read, delete: if isAdmin();
      allow create: if true; // Anyone can apply
    }

    match /newsletterSubscribers/{docId} {
      allow read, delete: if isAdmin(); // Admin can manage subscribers
      allow create: if true; // Anyone can subscribe
    }

    // Default deny for other collections
    match /{path=**}/_/{docId} {
      allow read, write: if false;
    }
  }
}
