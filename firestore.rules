
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function hasRole(role) {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles[role] == true;
    }
    
    function isAdmin() {
      return hasRole('admin');
    }

    // USER DATA: Users can read their own data. Admins can read/write any user data.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isAdmin();
    }
    
    // CONTENT: Public read access for published content. Write access for admins only.
    match /{collection}/{docId} {
       // All collections like 'menu', 'outlets', 'promotions', 'blogPosts', 'siteSettings'
       // are publicly readable but only writable by admins.
       // The 'status' field can be used to distinguish between 'draft' and 'published'.
       // Frontend queries should filter for `where('status', '==', 'published')`.
      allow get, list: if true;
      allow write: if isAdmin();
    }
    
    // FORM SUBMISSIONS: Only admins can read/write messages and franchise leads.
    match /messages/{messageId} {
        allow read, write, delete: if isAdmin();
    }
    
    match /franchiseLeads/{leadId} {
      allow read, write, delete: if isAdmin();
    }
  }
}
