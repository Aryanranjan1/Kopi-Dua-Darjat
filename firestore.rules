
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAdmin() {
      return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    // --- CMS Collections ---
    match /menuGroups/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    
    match /menuCategories/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /menuItems/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /promotions/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /dailySpecials/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /outlets/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    
    match /blogs/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /media/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /testimonials/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /faq/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // --- User-Submitted Content ---
    match /contactMessages/{docId} {
      allow read, delete: if isAdmin();
      allow create: if true;
      allow update: if false; 
    }

    match /franchiseApplications/{docId} {
      allow read, delete: if isAdmin();
      allow create: if true;
      allow update: if false;
    }

    match /newsletterSubscribers/{docId} {
      allow read, delete: if isAdmin();
      allow create: if true;
      allow update: if false;
    }

    // --- Admin Roles ---
    match /roles_admin/{userId} {
      allow read, write: if isAdmin();
    }
  }
}
