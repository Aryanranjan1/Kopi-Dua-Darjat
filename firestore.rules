
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAdmin() {
      // For MVP, we allow any signed-in user to be an "admin".
      // In a real app, this would check for a custom claim:
      // return request.auth != null && request.auth.token.role in ['admin', 'editor'];
      return request.auth != null;
    }

    // Contact and Franchise submissions should be write-only for the public
    match /contactMessages/{docId} {
      allow read, delete: if isAdmin();
      allow create: if true; // Anyone can send a message
      allow update: if false;
    }

    match /franchiseApplications/{docId} {
      allow read, delete: if isAdmin();
      allow create: if true; // Anyone can apply
      allow update: if false;
    }

    match /newsletterSubscribers/{docId} {
      allow read, delete: if isAdmin(); // Admin can manage subscribers
      allow create: if true; // Anyone can subscribe
      allow update: if false;
    }

    // CMS Collections: Public can read, admin can write
    match /menuCategories/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /menuItems/{docId} {
      allow read: if resource.data.status == 'published'; // Public can only read published items
      allow create, update, delete: if isAdmin();
      allow read: if isAdmin(); // Admin can read any status
    }

    match /promotions/{docId} {
      allow read: if resource.data.status == 'active'; // Public can only read active promotions
      allow create, update, delete: if isAdmin();
      allow read: if isAdmin(); // Admin can read any status
    }

    match /outlets/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Default deny for any other collections
    match /{path=**}/_/{docId} {
      allow read, write: if false;
    }
  }
}
