
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    match /public_insta_feed/{docId} {
      allow read: if true;
      allow write, delete: if isAdmin();
    }

    match /settings/{docId} {
      allow read: if true;
      allow write, delete: if isAdmin();
    }
    
    match /reviews/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // CMS Collections (Public Read + Admin Write)
    match /{collectionName}/{docId} where
      collectionName in ['menuGroups', 'menuCategories', 'menuItems', 'promotions', 'dailySpecials', 'outlets', 'blogs', 'media', 'testimonials', 'faq', 'specials', 'community_items'] {
      allow read: if true;
      allow write, delete: if isAdmin();
    }

    // User-Submitted Collections
    match /contactMessages/{docId} {
      allow create: if true;
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    match /franchiseApplications/{docId} {
      allow create: if true;
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    match /newsletterSubscribers/{docId} {
      allow create: if true;
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    // Function Logs (Function Create, Admin Read/Delete)
    match /sync_logs/{logId} {
        allow create: if request.auth == null;
        allow read, delete: if isAdmin();
        allow update: if false;
    }

    // Admin Roles
    match /roles_admin/{userId} {
      allow read, write: if isAdmin();
    }
  }
}
