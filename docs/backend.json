
{
  "entities": {
    "SiteSettings": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "SiteSettings",
      "type": "object",
      "description": "Centralized settings for the entire website.",
      "properties": {
        "brand": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "favicon": { "type": "string", "format": "uri" },
            "logoLight": { "type": "string", "format": "uri" },
            "logoDark": { "type": "string", "format": "uri" },
            "tagline": { "type": "string" },
            "primaryColor": { "type": "string" },
            "accentColor": { "type": "string" }
          }
        },
        "founders": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "role": { "type": "string" },
              "image": { "type": "string", "format": "uri" },
              "quote": { "type": "string" },
              "contact": { "type": "string", "format": "email" }
            }
          }
        },
        "contact": {
          "type": "object",
          "properties": {
            "email": { "type": "string", "format": "email" },
            "phone": { "type": "string" },
            "address": { "type": "string" },
            "googleMapsLink": { "type": "string", "format": "uri" },
            "businessHours": { "type": "string" }
          }
        },
        "socials": {
          "type": "object",
          "properties": {
            "instagram": { "type": "string", "format": "uri" },
            "facebook": { "type": "string", "format": "uri" },
            "tiktok": { "type": "string", "format": "uri" },
            "youtube": { "type": "string", "format": "uri" },
            "whatsapp": { "type": "string", "format": "uri" }
          }
        },
        "automation": {
          "type": "object",
          "properties": {
            "newsletterIntegration": { "type": "boolean" },
            "googleBusinessSync": { "type": "boolean" },
            "autoBackup": { "type": "boolean" },
            "appCheckEnforced": { "type": "boolean" }
          }
        },
        "meta": {
          "type": "object",
          "properties": {
            "defaultTitle": { "type": "string" },
            "defaultDescription": { "type": "string" },
            "defaultImage": { "type": "string", "format": "uri" },
            "keywords": { "type": "array", "items": { "type": "string" } }
          }
        },
        "lastUpdated": { "type": "string", "format": "date-time" },
        "updatedBy": { "type": "string" }
      }
    },
    "Outlet": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Outlet",
      "type": "object",
      "description": "Represents a Kopi Dua Darjat outlet location.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "address": { "type": "string" }
      }
    },
    "Testimonial": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Testimonial",
      "type": "object",
      "description": "Represents a customer or franchisee testimonial.",
      "properties": {
        "quote": { "type": "string" },
        "name": { "type": "string" },
        "designation": { "type": "string" },
        "image": { "type": "string" }
      }
    },
    "FaqItem": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "FAQ Item",
      "type": "object",
      "description": "A single frequently asked question and its answer.",
      "properties": {
        "category": { "type": "string", "enum": ["General", "Product", "Franchise"] },
        "question": { "type": "string" },
        "answer": { "type": "string" }
      }
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/outlets/{outletId}",
        "definition": {
          "entityName": "Outlet",
          "schema": { "$ref": "#/entities/Outlet" },
          "description": "Stores Kopi Dua Darjat outlet information.",
          "params": [{ "name": "outletId", "description": "Unique identifier for the outlet." }]
        }
      },
      {
        "path": "/settings/{docId}",
        "definition": {
          "entityName": "SiteSettings",
          "schema": { "$ref": "#/entities/SiteSettings" },
          "description": "Stores global website settings in a single document, typically with ID 'main'.",
          "params": [{ "name": "docId", "description": "The ID of the settings document (e.g., 'main')." }]
        }
      },
       {
        "path": "/testimonials/{testimonialId}",
        "definition": {
          "entityName": "Testimonial",
          "schema": { "$ref": "#/entities/Testimonial" },
          "description": "Stores testimonial data.",
          "params": [{ "name": "testimonialId", "description": "Unique identifier for the testimonial." }]
        }
      },
      {
        "path": "/faq/{faqId}",
        "definition": {
          "entityName": "FaqItem",
          "schema": { "$ref": "#/entities/FaqItem" },
          "description": "Stores individual FAQ items.",
          "params": [{ "name": "faqId", "description": "Unique identifier for the FAQ item." }]
        }
      },
      {
        "path": "/roles_admin/{userId}",
        "definition": {
          "entityName": "adminRole",
          "schema": { "$ref": "#/entities/SiteSetting" },
          "description": "Documents in this collection indicate admin role. Existence of document implies admin rights.",
          "params": [{ "name": "userId", "description": "The ID of the user with admin permissions." }]
        }
      }
    ]
  }
}
