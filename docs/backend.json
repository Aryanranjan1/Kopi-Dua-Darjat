
{
  "entities": {
    "SiteSettings": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "SiteSettings",
      "type": "object",
      "description": "Centralized settings for the entire website.",
      "properties": {
        "brand": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "favicon": { "type": "string", "format": "uri" },
            "logoLight": { "type": "string", "format": "uri" },
            "logoDark": { "type": "string", "format": "uri" },
            "tagline": { "type": "string" },
            "primaryColor": { "type": "string" },
            "accentColor": { "type": "string" }
          }
        },
        "founders": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "role": { "type": "string" },
              "image": { "type": "string", "format": "uri" },
              "quote": { "type": "string" },
              "contact": { "type": "string", "format": "email" }
            }
          }
        },
        "contact": {
          "type": "object",
          "properties": {
            "email": { "type": "string", "format": "email" },
            "phone": { "type": "string" },
            "address": { "type": "string" },
            "googleMapsLink": { "type": "string", "format": "uri" },
            "businessHours": { "type": "string" }
          }
        },
        "socials": {
          "type": "object",
          "properties": {
            "instagram": { "type": "string", "format": "uri" },
            "facebook": { "type": "string", "format": "uri" },
            "tiktok": { "type": "string", "format": "uri" },
            "youtube": { "type": "string", "format": "uri" },
            "whatsapp": { "type": "string", "format": "uri" }
          }
        },
        "automation": {
          "type": "object",
          "properties": {
            "newsletterIntegration": { "type": "boolean" },
            "googleBusinessSync": { "type": "boolean" },
            "autoBackup": { "type": "boolean" },
            "appCheckEnforced": { "type": "boolean" }
          }
        },
        "meta": {
          "type": "object",
          "properties": {
            "defaultTitle": { "type": "string" },
            "defaultDescription": { "type": "string" },
            "defaultImage": { "type": "string", "format": "uri" },
            "keywords": { "type": "array", "items": { "type": "string" } }
          }
        },
        "lastUpdated": { "type": "string", "format": "date-time" },
        "updatedBy": { "type": "string" }
      }
    },
    "Outlet": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Outlet",
      "type": "object",
      "description": "Represents a Kopi Dua Darjat outlet location.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "address": { "type": "string" }
      }
    },
    "Testimonial": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Testimonial",
      "type": "object",
      "description": "Represents a customer or franchisee testimonial.",
      "properties": {
        "quote": { "type": "string" },
        "name": { "type": "string" },
        "designation": { "type": "string" },
        "image": { "type": "string" }
      }
    },
    "FaqItem": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "FAQ Item",
      "type": "object",
      "description": "A single frequently asked question and its answer.",
      "properties": {
        "category": { "type": "string", "enum": ["General", "Product", "Franchise"] },
        "question": { "type": "string" },
        "answer": { "type": "string" }
      }
    },
    "CommunityItem": {
      "title": "Community Item",
      "type": "object",
      "description": "An item to be displayed in the community grid on the homepage.",
      "properties": {
          "type": { "type": "string", "enum": ["portrait", "logo", "quote"]},
          "name": { "type": "string" },
          "imageUrl": { "type": "string", "format": "uri" },
          "quote": { "type": "string" },
          "role": { "type": "string" },
          "bgColor": { "type": "string" },
          "textColor": { "type": "string" },
          "className": { "type": "string" },
          "displayOrder": { "type": "number"}
      }
    },
    "PublicInstaPost": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Public Instagram Post",
      "type": "object",
      "description": "Represents a public Instagram post scraped from a hashtag feed.",
      "properties": {
        "id": { "type": "string", "description": "The unique ID of the Instagram post." },
        "username": { "type": "string", "description": "The username of the account that posted." },
        "caption": { "type": "string", "description": "The caption text of the post." },
        "mediaUrl": { "type": "string", "format": "uri", "description": "Direct URL to the image or video." },
        "mediaType": { "type": "string", "enum": ["IMAGE", "VIDEO", "CAROUSEL_ALBUM"], "description": "The type of media." },
        "permalink": { "type": "string", "format": "uri", "description": "The permanent link to the post on Instagram." },
        "timestamp": { "type": "string", "format": "date-time", "description": "The timestamp when the post was created." },
        "visible": { "type": "boolean", "description": "Whether the post is visible on the public site." },
        "pinned": { "type": "boolean", "description": "Whether the post is pinned to the top of the feed." },
        "rank": { "type": "number", "description": "The display order of the post." },
        "source": { "type": "string", "enum": ["scraper", "manual", "graph"], "description": "The origin of the post." }
      },
      "required": ["id", "username", "mediaUrl", "mediaType", "permalink", "timestamp", "visible", "pinned", "rank", "source"]
    },
     "InstagramSyncSettings": {
      "title": "Instagram Sync Settings",
      "type": "object",
      "description": "Settings for the Instagram feed synchronization.",
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["scraper", "graph"],
          "description": "The sync mode: scraper (public hashtag) or graph (Graph API)."
        },
        "active_tag": {
          "type": "string",
          "description": "The hashtag to sync in scraper mode, without the '#' symbol."
        },
        "last_synced": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of the last successful sync."
        },
        "auto_sync_enabled": {
          "type": "boolean",
          "description": "Whether the daily automatic sync is enabled."
        },
        "graph_access_token": {
          "type": "string",
          "description": "The long-lived access token for the Instagram Graph API."
        },
        "graph_account_id": {
          "type": "string",
          "description": "The ID of the connected Instagram Business account."
        }
      },
      "required": ["mode", "active_tag", "auto_sync_enabled"]
    },
    "SyncLog": {
        "title": "Sync Log",
        "type": "object",
        "description": "A log entry for an Instagram sync operation.",
        "properties": {
            "tag": { "type": "string" },
            "timestamp": { "type": "string", "format": "date-time" },
            "post_count": { "type": "number" },
            "origin": { "type": "string" },
            "status": { "type": "string", "enum": ["success", "failed"] },
            "error": { "type": "string" },
            "stack": { "type": "string" }
        }
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/outlets/{outletId}",
        "definition": {
          "entityName": "Outlet",
          "schema": { "$ref": "#/entities/Outlet" },
          "description": "Stores Kopi Dua Darjat outlet information.",
          "params": [{ "name": "outletId", "description": "Unique identifier for the outlet." }]
        }
      },
      {
        "path": "/settings/{docId}",
        "definition": {
          "entityName": "SiteSettings",
          "schema": { "$ref": "#/entities/SiteSettings" },
          "description": "Stores global website settings. 'main' stores SiteSettings, 'instagram_sync' stores InstagramSyncSettings.",
          "params": [{ "name": "docId", "description": "The ID of the settings document (e.g., 'main', 'instagram_sync')." }]
        }
      },
       {
        "path": "/testimonials/{testimonialId}",
        "definition": {
          "entityName": "Testimonial",
          "schema": { "$ref": "#/entities/Testimonial" },
          "description": "Stores testimonial data.",
          "params": [{ "name": "testimonialId", "description": "Unique identifier for the testimonial." }]
        }
      },
      {
        "path": "/faq/{faqId}",
        "definition": {
          "entityName": "FaqItem",
          "schema": { "$ref": "#/entities/FaqItem" },
          "description": "Stores individual FAQ items.",
          "params": [{ "name": "faqId", "description": "Unique identifier for the FAQ item." }]
        }
      },
      {
        "path": "/community_items/{itemId}",
        "definition": {
          "entityName": "CommunityItem",
          "schema": { "$ref": "#/entities/CommunityItem" },
          "description": "Stores items for the homepage community grid.",
          "params": [{ "name": "itemId", "description": "Unique identifier for the community item." }]
        }
      },
      {
        "path": "/roles_admin/{userId}",
        "definition": {
          "entityName": "adminRole",
          "schema": { "$ref": "#/entities/SiteSetting" },
          "description": "Documents in this collection indicate admin role. Existence of document implies admin rights.",
          "params": [{ "name": "userId", "description": "The ID of the user with admin permissions." }]
        }
      },
      {
        "path": "/public_insta_feed/{postId}",
        "definition": {
          "entityName": "PublicInstaPost",
          "schema": { "$ref": "#/entities/PublicInstaPost" },
          "description": "Stores scraped public Instagram posts tagged with the active hashtag. Updated by a Cloud Function.",
          "params": [{ "name": "postId", "description": "The unique ID of the Instagram post." }]
        }
      },
      {
        "path": "/sync_logs/{logId}",
        "definition": {
          "entityName": "SyncLog",
          "schema": { "$ref": "#/entities/SyncLog" },
          "description": "Logs the result of each Instagram sync operation.",
          "params": [{ "name": "logId", "description": "The unique ID of the log entry." }]
        }
      }
    ]
  }
}

    